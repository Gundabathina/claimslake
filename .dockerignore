# Keep the Docker build context small and reproducible.
# Anything listed here is NOT sent to the Docker daemon during build.

# Python virtual environments & caches
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Version control & CI
.git/
.gitignore
.github/

# Local data, logs, and generated artifacts (regenerated inside the container)
*.log
logs/
bronze/*.parquet
silver/*.parquet
data_quality/metrics/*.json

# Editor / OS cruft
.idea/
.vscode/
.DS_Store

# Docker & compose files are not needed inside the image
docker-compose.yml
.dockerignore
